{
  "displayName": "Luma agent \u00b7 performance, reliability, security and cost",
  "gridLayout": {
    "columns": "2",
    "widgets": [
      {
        "title": "Completed turns",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/luma_completed\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_SUM"
                  }
                }
              },
              "plotType": "LINE"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Internal failures / cancelled streams",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/luma_failed\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_SUM"
                  }
                }
              },
              "plotType": "LINE"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Completion p50 (seconds)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/luma_latency\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_50"
                  }
                }
              },
              "plotType": "LINE"
            }
          ],
          "yAxis": {
            "scale": "LINEAR"
          }
        }
      },
