GOOGLE_CLOUD_PROJECT=sitiosweb1
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
# USE_GCLOUD_CREDENTIALS=true
# GCLOUD_ACCOUNT=your-authorized-account@example.com
ENVIRONMENT=development
LOCAL_DEV_AUTH=true
LOCAL_AGENT=false
CATALOG_POINTER_PATH=data/active-catalog.json
# Leave CATALOG_PATH unset for automatic versioned updates.
# Fixed CATALOG_PATH / RETRIEVAL_BUNDLE_PATH are supported for repeatable evaluations.
# AGENT_RUNTIME_RESOURCE=projects/sitiosweb1/locations/us-central1/reasoningEngines/ID
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
