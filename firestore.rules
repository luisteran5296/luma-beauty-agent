rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // These rules are only a reference: do not replace existing project rules.
    // Admin SDK accesses store collections through service-account IAM.
    match /beauty_store_catalogs/{document=**} { allow read, write: if false; }
    match /beauty_store_metadata/{document=**} { allow read, write: if false; }
    match /beauty_store_sessions/{document=**} { allow read, write: if false; }
    match /beauty_store_quotas/{document=**} { allow read, write: if false; }
  }
}
